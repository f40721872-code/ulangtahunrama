<title>Hari Istimewamu</title>
<link rel="preconnect" href="https://fonts.googleapis.com">
<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
<link rel="stylesheet" href="https://fonts.googleapis.com/css2?family=Cormorant+Garamond:ital,wght@0,400;0,600;1,400;1,500&family=Pinyon+Script&family=Jost:wght@300;400;500&display=swap">
<style>
/* Layout: satu kolom sempit seperti surat, langit malam dengan hati yang melayang, kue ulang tahun interaktif di tengah */
:root {
  --night: #1a0f1f;
  --night-2: #2a1530;
  --petal: #f3c9d0;
  --rose: #e58aa0;
  --gold: #f0c987;
  --ink: #f7ece8;
  --ink-soft: #cdb7bf;
  --line: rgba(243, 201, 208, 0.22);
  --font-display: "Cormorant Garamond", "Georgia", serif;
  --font-script: "Pinyon Script", "Brush Script MT", cursive;
  --font-body: "Jost", "Helvetica Neue", Arial, sans-serif;
  color-scheme: dark;
}
* { box-sizing: border-box; }
html { background: var(--night); }
body {
  margin: 0;
  padding-inline: 20px;
  padding-block: 0 56px;
  background:
    radial-gradient(900px 500px at 50% -80px, rgba(229, 138, 160, 0.28), transparent 70%),
    radial-gradient(700px 600px at 100% 40%, rgba(240, 201, 135, 0.08), transparent 70%),
    linear-gradient(180deg, var(--night-2) 0%, var(--night) 55%);
  background-color: var(--night);
  color: var(--ink);
  font-family: var(--font-body);
  font-weight: 300;
  font-size: 17px;
  line-height: 1.75;
  overflow-x: hidden;
}
#sky { position: fixed; inset: 0; width: 100%; height: 100%; pointer-events: none; z-index: 0; }
main { position: relative; z-index: 1; max-width: 640px; margin-inline: auto; }
section { padding-block: 44px; }
h1, h2, h3, p { margin: 0; }
h2 {
  font-family: var(--font-display);
  font-style: italic;
  font-weight: 500;
  font-size: clamp(1.9rem, 6vw, 2.5rem);
  line-height: 1.2;
  text-wrap: balance;
  color: var(--petal);
}
.label {
  font-family: var(--font-body);
  font-weight: 400;
  font-size: 0.72rem;
  letter-spacing: 0.28em;
  text-transform: uppercase;
  color: var(--gold);
}

/* Hero */
.hero { text-align: center; padding-block: 72px 24px; display: flex; flex-direction: column; align-items: center; gap: 14px; }
.hero h1 {
  font-family: var(--font-display);
  font-weight: 400;
  font-style: italic;
  font-size: clamp(2.1rem, 8vw, 3.2rem);
  line-height: 1.1;
  text-wrap: balance;
}
.hero .nama {
  font-family: var(--font-script);
  font-size: clamp(4rem, 19vw, 7rem);
  line-height: 1.05;
  color: var(--petal);
  text-shadow: 0 0 40px rgba(229, 138, 160, 0.55);
  overflow-wrap: anywhere;
  padding-inline: 4px;
}
.hero .sub { max-width: 30ch; color: var(--ink-soft); text-wrap: balance; }
.ornament { width: 120px; height: 14px; color: var(--gold); margin-top: 6px; }

/* Kue */
.cake-wrap { display: flex; flex-direction: column; align-items: center; gap: 18px; text-align: center; }
.cake { width: min(300px, 78vw); height: auto; cursor: pointer; overflow: visible; }
.cake:focus-visible { outline: 2px solid var(--gold); outline-offset: 6px; border-radius: 12px; }
.flame { transform-origin: center bottom; transform-box: fill-box; animation: flicker 1.3s ease-in-out infinite alternate; transition: opacity 0.5s, transform 0.5s; }
.flame:nth-of-type(2) { animation-delay: -0.4s; }
.flame:nth-of-type(3) { animation-delay: -0.8s; }
@keyframes flicker { from { transform: scale(1, 1) rotate(-3deg); } to { transform: scale(0.88, 1.1) rotate(3deg); } }
.out .flame { opacity: 0; transform: scale(0.2); animation: none; }
.smoke { opacity: 0; }
.out .smoke { animation: smoke 2.4s ease-out forwards; }
@keyframes smoke { 0% { opacity: 0.7; transform: translateY(0); } 100% { opacity: 0; transform: translateY(-26px); } }
.btn {
  font-family: var(--font-body);
  font-size: 0.82rem;
  font-weight: 500;
  letter-spacing: 0.16em;
  text-transform: uppercase;
  color: var(--night);
  background: linear-gradient(135deg, var(--petal), var(--rose));
  border: 0;
  border-radius: 999px;
  padding: 13px 28px;
  cursor: pointer;
  box-shadow: 0 8px 30px rgba(229, 138, 160, 0.35);
  transition: transform 0.2s, box-shadow 0.2s;
}
.btn:hover { transform: translateY(-2px); box-shadow: 0 12px 34px rgba(229, 138, 160, 0.5); }
.btn:focus-visible { outline: 2px solid var(--gold); outline-offset: 3px; }
.wish-line { min-height: 3.4em; font-family: var(--font-display); font-style: italic; font-size: 1.3rem; line-height: 1.45; color: var(--petal); max-width: 28ch; text-wrap: balance; }

/* Surat */
.letter {
  border-top: 1px solid var(--line);
  border-bottom: 1px solid var(--line);
  padding-block: 40px;
  display: flex;
  flex-direction: column;
  gap: 22px;
}
.letter .salam { font-family: var(--font-script); font-size: 2.4rem; line-height: 1.2; color: var(--gold); overflow-wrap: anywhere; }
.letter p { font-family: var(--font-display); font-size: 1.28rem; line-height: 1.7; font-weight: 400; color: var(--ink); text-wrap: pretty; }
.letter .ttd { font-family: var(--font-script); font-size: 2.1rem; color: var(--petal); text-align: right; line-height: 1.3; overflow-wrap: anywhere; }

/* Alasan */
.reasons { display: flex; flex-direction: column; gap: 0; margin-top: 22px; }
.reason { display: grid; grid-template-columns: 22px minmax(0, 1fr); column-gap: 16px; padding-block: 22px; border-top: 1px solid var(--line); }
.reason:last-child { border-bottom: 1px solid var(--line); }
.reason svg { width: 20px; height: 20px; margin-top: 5px; color: var(--rose); }
.reason h3 { font-family: var(--font-display); font-weight: 600; font-size: 1.3rem; line-height: 1.3; color: var(--petal); }
.reason p { color: var(--ink-soft); font-size: 0.98rem; line-height: 1.7; margin-top: 4px; }

/* Doa */
.wishes { display: grid; grid-template-columns: repeat(auto-fit, minmax(min(100%, 180px), 1fr)); gap: 14px; margin-top: 22px; }
.wish {
  padding: 22px 20px;
  border: 1px solid var(--line);
  border-radius: 6px;
  background: linear-gradient(160deg, rgba(243, 201, 208, 0.08), rgba(243, 201, 208, 0.02));
  min-width: 0;
}
.wish h3 { font-family: var(--font-script); font-size: 2rem; line-height: 1.2; color: var(--gold); font-weight: 400; }
.wish p { margin-top: 6px; font-size: 0.95rem; line-height: 1.65; color: var(--ink-soft); }

/* Penutup */
.closing { text-align: center; display: flex; flex-direction: column; align-items: center; gap: 14px; padding-block: 56px 28px; }
.closing .big { font-family: var(--font-display); font-style: italic; font-size: clamp(1.8rem, 6.5vw, 2.4rem); line-height: 1.3; text-wrap: balance; color: var(--petal); max-width: 20ch; }
.closing .heart { width: 34px; height: 34px; color: var(--rose); filter: drop-shadow(0 0 12px rgba(229, 138, 160, 0.7)); animation: beat 1.6s ease-in-out infinite; }
@keyframes beat { 0%, 100% { transform: scale(1); } 15% { transform: scale(1.18); } 30% { transform: scale(1); } 45% { transform: scale(1.12); } }

/* Ubah nama */
details.edit { margin-top: 36px; border: 1px dashed var(--line); border-radius: 8px; padding: 12px 16px; font-size: 0.88rem; color: var(--ink-soft); }
details.edit summary { cursor: pointer; letter-spacing: 0.1em; }
details.edit summary:focus-visible { outline: 2px solid var(--gold); outline-offset: 3px; }
.fields { display: grid; grid-template-columns: repeat(auto-fit, minmax(min(100%, 200px), 1fr)); gap: 12px; margin-top: 14px; }
.fields label { display: flex; flex-direction: column; gap: 4px; font-size: 0.78rem; letter-spacing: 0.08em; min-width: 0; }
.fields input {
  font: inherit; font-size: 1rem; color: var(--ink);
  background: rgba(255, 255, 255, 0.06);
  border: 1px solid var(--line); border-radius: 6px; padding: 9px 12px; min-width: 0; width: 100%;
}
.fields input:focus-visible { outline: 2px solid var(--gold); outline-offset: 1px; }

.reveal { animation: rise 0.9s ease both; }
@keyframes rise { from { opacity: 0.001; transform: translateY(14px); } to { opacity: 1; transform: none; } }
@media (prefers-reduced-motion: reduce) {
  *, *::before, *::after { animation: none !important; transition: none !important; }
}
</style>

