<script>
(function () {
  var reduce = window.matchMedia && window.matchMedia("(prefers-reduced-motion: reduce)").matches;
  var inNama = document.getElementById("in-nama");
  var inDari = document.getElementById("in-dari");

  function applyNames() {
    var n = inNama.value.trim() || "Sahabatku";
    var d = inDari.value.trim() || "seseorang yang menyayangimu";
    document.querySelectorAll("[data-nama]").forEach(function (el) { el.textContent = n; });
    document.querySelectorAll("[data-dari]").forEach(function (el) { el.textContent = d; });
    try { localStorage.setItem("ultah-nama", inNama.value); localStorage.setItem("ultah-dari", inDari.value); } catch (e) {}
  }
  try {
    var sn = localStorage.getItem("ultah-nama"), sd = localStorage.getItem("ultah-dari");
    if (sn) inNama.value = sn;
    if (sd) inDari.value = sd;
  } catch (e) {}
  inNama.addEventListener("input", applyNames);
  inDari.addEventListener("input", applyNames);
  applyNames();

  /* Langit: hati dan kilau yang melayang pelan */
  var cv = document.getElementById("sky"), ctx = cv.getContext("2d");
  var W = 0, H = 0, dpr = Math.min(window.devicePixelRatio || 1, 2);
  var motes = [], bits = [];
  function resize() {
    W = window.innerWidth; H = window.innerHeight;
    cv.width = W * dpr; cv.height = H * dpr;
    ctx.setTransform(dpr, 0, 0, dpr, 0, 0);
  }
  function heartPath(x, y, s) {
    ctx.beginPath();
    ctx.moveTo(x, y + s * 0.35);
    ctx.bezierCurveTo(x - s, y - s * 0.35, x - s * 0.55, y - s * 1.05, x, y - s * 0.5);
    ctx.bezierCurveTo(x + s * 0.55, y - s * 1.05, x + s, y - s * 0.35, x, y + s * 0.35 + s * 0.65);
    ctx.closePath();
  }
  function spawnMote(initial) {
    return {
      x: Math.random() * W, y: initial ? Math.random() * H : H + 20,
      s: 4 + Math.random() * 9, v: 0.15 + Math.random() * 0.4,
      sway: Math.random() * Math.PI * 2, sp: 0.004 + Math.random() * 0.008,
      a: 0.12 + Math.random() * 0.28, heart: Math.random() < 0.45,
      c: Math.random() < 0.7 ? "229,138,160" : "240,201,135"
    };
  }
  function seed() {
    motes = [];
    var n = Math.round(Math.min(34, Math.max(16, W / 28)));
    for (var i = 0; i < n; i++) motes.push(spawnMote(true));
  }
  function confetti() {
    var cols = ["#f3c9d0", "#e58aa0", "#f0c987", "#f7ece8", "#c2607c"];
    for (var i = 0; i < 110; i++) {
      var ang = Math.random() * Math.PI * 2, sp = 3 + Math.random() * 7;
      bits.push({
        x: W / 2, y: H * 0.38, vx: Math.cos(ang) * sp, vy: Math.sin(ang) * sp - 4,
        r: 3 + Math.random() * 4, rot: Math.random() * 6, vr: (Math.random() - 0.5) * 0.3,
        c: cols[i % cols.length], life: 1, heart: Math.random() < 0.3
      });
    }
  }
  function frame() {
    ctx.clearRect(0, 0, W, H);
    for (var i = 0; i < motes.length; i++) {
      var m = motes[i];
      m.y -= m.v; m.sway += m.sp; m.x += Math.sin(m.sway) * 0.35;
      if (m.y < -30) motes[i] = spawnMote(false);
      ctx.fillStyle = "rgba(" + m.c + "," + m.a + ")";
      if (m.heart) { heartPath(m.x, m.y, m.s); ctx.fill(); }
      else { ctx.beginPath(); ctx.arc(m.x, m.y, m.s * 0.22, 0, 6.2832); ctx.fill(); }
    }
    for (var j = bits.length - 1; j >= 0; j--) {
      var b = bits[j];
      b.vy += 0.16; b.vx *= 0.99; b.x += b.vx; b.y += b.vy; b.rot += b.vr; b.life -= 0.0045;
      if (b.life <= 0 || b.y > H + 20) { bits.splice(j, 1); continue; }
      ctx.save();
      ctx.globalAlpha = Math.max(b.life, 0);
      ctx.fillStyle = b.c;
      ctx.translate(b.x, b.y); ctx.rotate(b.rot);
      if (b.heart) { heartPath(0, 0, b.r * 1.2); ctx.fill(); }
      else ctx.fillRect(-b.r, -b.r * 0.5, b.r * 2, b.r);
      ctx.restore();
    }
    requestAnimationFrame(frame);
  }
  resize(); seed();
  window.addEventListener("resize", function () { resize(); seed(); });
  if (reduce) {
    ctx.clearRect(0, 0, W, H);
    motes.forEach(function (m) {
      ctx.fillStyle = "rgba(" + m.c + "," + m.a + ")";
      if (m.heart) { heartPath(m.x, m.y, m.s); ctx.fill(); }
      else { ctx.beginPath(); ctx.arc(m.x, m.y, m.s * 0.22, 0, 6.2832); ctx.fill(); }
    });
  } else {
    requestAnimationFrame(frame);
  }

  /* Tiup lilin */
  var cake = document.getElementById("cake");
  var btn = document.getElementById("blow");
  var line = document.getElementById("wish-line");
  var done = false;
  function blow() {
    if (done) {
      cake.classList.remove("out");
      done = false;
      btn.textContent = "Tiup lilin";
      line.textContent = "Pejamkan mata, simpan satu harapan, lalu tiup lilinnya.";
      return;
    }
    done = true;
    cake.classList.add("out");
    btn.textContent = "Nyalakan lagi";
    line.textContent = "Semoga setiap harapan yang kamu simpan menemukan jalannya padamu.";
    if (!reduce) confetti();
  }
  btn.addEventListener("click", blow);
  cake.addEventListener("click", function () { if (!done) blow(); });
  cake.addEventListener("keydown", function (e) {
    if (e.key === "Enter" || e.key === " ") { e.preventDefault(); if (!done) blow(); }
  });
})();
</script>
